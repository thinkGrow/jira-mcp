# Which data source the MCP server reads from.
#   mock -> reads/writes mock/tickets.json and mock/images (demo)
#   http -> calls the real ticketing API (after approval)
TICKET_PROVIDER=mock

# Only used when TICKET_PROVIDER=http
TICKET_API_BASE_URL=https://tickets.internal.example.com/api
TICKET_API_TOKEN=replace-with-real-token
